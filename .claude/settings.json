{
  "permissions": {
    "allow": [
      "Bash(uv run gmaj:*)",
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "PowerShell(uv run gmaj:*)",
      "PowerShell(uv sync:*)",
      "Bash(codex exec:*)",
      "PowerShell(codex exec:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uv run gmaj update --auto",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
